{
  "name": "paseo-acp-goal",
  "version": "0.1.2",
  "private": true,
  "description": "Keep ACP agents working until a declared goal is met, with hard anti-runaway guards.",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "auto-continue",
    "goal",
    "paseo",
    "paseo-plugin"
  ],
  "license": "MIT",
  "author": "sequico",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sequico/paseo-acp-goal.git"
  },
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --max-warnings=0",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@getpaseo/client": "0.9.1",
    "@getpaseo/plugin": "0.9.1",
    "@getpaseo/protocol": "0.9.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "esbuild": "^0.25.12",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
